# Fill these values only after the OpenAI-compatible endpoint is confirmed.
# Do not commit real credentials.
ACADEMIC_API_BASE=
ACADEMIC_API_KEY=
ACADEMIC_MODEL=gpt-5.4

# CoSIL/SWE-Explore runtime
COSIL_PATH=/workspace/projects/cosil-swe-explore-repro/third_party/CoSIL
COSIL_CONDA_ENV=cosil
EXPLORER_CODES_ROOT=/workspace/projects/cosil-swe-explore-repro/third_party

# Main reproduction arm; function mode is an offline post-processing option.
COSIL_REGION_MODE=file
COSIL_MAX_ITER=10
COSIL_TOP_K=5
COSIL_WORKERS=1
COSIL_TRACE_DIR=results/cosil_traces
